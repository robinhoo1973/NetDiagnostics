# Build artifacts
build/
build-*/
dist/
*.log
*.bak
legacy_backup/

# IDE / tools
.claude/
.codewhale/
.deepseek/
.vscode/

# Certificates & signing (sensitive)
resources/cert/
!resources/cert/README.md

# Global sensitive-file patterns — never commit signing material or secrets
*.p12
*.pfx
*.key
*.pem
*.p8
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
*.cer
*.csr
.env
.env.*
*.secret
*_rsa
*_ed25519

# Generated from .in template by CMake / CI — team ID injected at build time
resources/apple/macos.entitlements

# Docs — only privacy-policy.html is public
docs/*
!docs/privacy-policy.html

# Temp files
crashes/
commit_msg.txt
AGENTS.md
CLAUDE.md
scripts/
# Screenshot CI drivers MUST be tracked (the CI pipelines call them at runtime).
!scripts/screenshot/
!scripts/pre-commit
!scripts/ci-http-server.py
!scripts/install-hooks
review/

# CodeWhale config — only constitution.json is shared
**/.codewhale/*
!**/.codewhale/constitution.json

# UI mockups (planned features, not for public)
mockups/
# Internal test profiles and policies
profiles/