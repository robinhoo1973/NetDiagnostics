#!/bin/bash
# =============================================================================
# pre-commit — 提交前自动检查已知问题模式
#
# 检查规则来自:
#   review/ios-startup-crash-5why-analysis.md — iOS 启动闪退 5WHY 分析（全局默认检查）
#   review/ios-ci-known-issues.md — iOS CI/build 已知问题模式
# 任何检查失败 → 提交中止，修复后重试。
# =============================================================================
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
EXIT=0
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

pass()  { echo -e "${GREEN}[PASS]${NC} $1"; }
fail()  { echo -e "${RED}[FAIL]${NC} $1"; EXIT=1; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Pre-commit: checking for known issue patterns..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ── Get list of staged files ───────────────────────────────────────────────
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED" ]; then
    echo "No staged files — nothing to check."
    exit 0
fi

# ── 1. CMake: no // comments ──────────────────────────────────────────────
echo ""
echo "── 1. CMake comment syntax (// forbidden) ──"
CMAKE_FILES=$(echo "$STAGED" | grep -E '\.cmake$|CMakeLists\.txt$' || true)
if [ -n "$CMAKE_FILES" ]; then
    for f in $CMAKE_FILES; do
        if git show ":$f" | grep -n '//' | grep -v 'http://\|https://' > /tmp/precommit-cmake-comment.log 2>/dev/null; then
            fail "$f: C++-style comments (//) found — use # for CMake"
            cat /tmp/precommit-cmake-comment.log | while read line; do
                echo "       $line"
            done
        else
            pass "$f"
        fi
    done
else
    pass "no staged CMake files"
fi

# ── 2. CMake regex: no {n} quantifier ─────────────────────────────────────
echo ""
echo "── 2. CMake regex {n} quantifier ──"
if [ -n "$CMAKE_FILES" ]; then
    for f in $CMAKE_FILES; do
        if git show ":$f" | grep -nE '\{[0-9]+\}' | grep -v 'http' > /tmp/precommit-cmake-regex.log 2>/dev/null; then
            fail "$f: {n} quantifier in CMake regex — CMake does not support this"
            cat /tmp/precommit-cmake-regex.log | while read line; do
                echo "       $line"
            done
        else
            pass "$f"
        fi
    done
else
    pass "no staged CMake files"
fi

# ── 3. Preprocessor: no #ifdef/#ifndef in C++ files ────────────────────────
echo ""
echo "── 3. Preprocessor style (#ifdef/#ifndef forbidden) ──"
CPP_FILES=$(echo "$STAGED" | grep -E '\.(cpp|h|hpp|mm|m|c)$' || true)
if [ -n "$CPP_FILES" ]; then
    for f in $CPP_FILES; do
        if git show ":$f" | grep -nE '^#ifdef |^#ifndef ' > /tmp/precommit-ifdef.log 2>/dev/null; then
            fail "$f: #ifdef/#ifndef found — use #if(defined(X)) for CI compliance"
            cat /tmp/precommit-ifdef.log | while read line; do
                echo "       $line"
            done
        else
            pass "$f"
        fi
    done
else
    pass "no staged C/C++ files"
fi

# ── 4. Preprocessor: no #elif in C++ files ─────────────────────────────────
echo ""
echo "── 4. Preprocessor #elif check ──"
if [ -n "$CPP_FILES" ]; then
    for f in $CPP_FILES; do
        if git show ":$f" | grep -nE '^#elif ' > /tmp/precommit-elif.log 2>/dev/null; then
            fail "$f: #elif found — use #else + #if for CI preprocessor balance"
            cat /tmp/precommit-elif.log | while read line; do
                echo "       $line"
            done
        else
            pass "$f"
        fi
    done
else
    pass "no staged C/C++ files"
fi

# ── 5. No UTF-8 BOM ────────────────────────────────────────────────────────
echo ""
echo "── 5. UTF-8 BOM check ──"
for f in $STAGED; do
    if [ -f "$ROOT/$f" ]; then
        if hexdump -n 3 -C "$ROOT/$f" | grep -q 'ef bb bf'; then
            fail "$f: UTF-8 BOM detected — remove it"
        fi
    fi
done
pass "no BOM found in staged files"

# ── 6. Palette sync ───────────────────────────────────────────────────────
echo ""
echo "── 6. AppColors.h ↔ Palette.js sync ──"
if echo "$STAGED" | grep -qE 'AppColors\.h|Palette\.js'; then
    if cmake -P "$ROOT/cmake/VerifyPaletteSync.cmake" > /tmp/precommit-palette.log 2>&1; then
        pass "palette sync OK"
    else
        fail "Palette sync failed — update both AppColors.h and Palette.js"
        cat /tmp/precommit-palette.log | while read line; do
            echo "       $line"
        done
    fi
else
    pass "no palette files staged"
fi

# ── 7. Apple entitlements: no derived attributes ──────────────────────────
echo ""
echo "── 7. Apple entitlements (derived attributes check) ──"
ENT_FILES=$(echo "$STAGED" | grep -E '\.entitlements$|\.entitlements\.in$' || true)
if [ -n "$ENT_FILES" ]; then
    for f in $ENT_FILES; do
        if git show ":$f" | grep -qE 'application-identifier|developer\.team-identifier'; then
            fail "$f: contains derived entitlements (application-identifier / team-identifier)"
        else
            pass "$f"
        fi
    done
else
    pass "no entitlement files staged"
fi

# ── 8. CI YAML: pipefail check ────────────────────────────────────────────
echo ""
echo "── 8. CI YAML pipefail check ──"
CI_FILES=$(echo "$STAGED" | grep -E '\.github/workflows/.*\.yml$' || true)
if [ -n "$CI_FILES" ]; then
    for f in $CI_FILES; do
        if git show ":$f" | grep -qE '^\s+run: \|' && \
           ! git show ":$f" | grep -A1 '^\s\+run: |' | grep -q 'set -euo pipefail'; then
            warn "$f: consider adding 'set -euo pipefail' to run: | blocks"
        else
            pass "$f"
        fi
    done
else
    pass "no CI workflow files staged"
fi

# ── 9. QColor(QRgb) alpha byte — 6-digit hex macros (missing alpha) ───────
echo ""
echo "── 9. QColor(QRgb) alpha byte (6-digit hex macro check) ──"
if [ -n "$CPP_FILES" ]; then
    for f in $CPP_FILES; do
        if git show ":$f" | grep -nE '#define.*0x[0-9A-Fa-f]{6}[^0-9A-Fa-f]' \
            | grep -v '0xFF' > /tmp/precommit-rgb.log 2>/dev/null; then
            fail "$f: 6-digit hex macro without alpha — QColor(QRgb) will be transparent"
            cat /tmp/precommit-rgb.log | while read line; do
                echo "       $line"
            done
        else
            pass "$f"
        fi
    done
else
    pass "no staged C/C++ files"
fi

# ── 10. Apple SDK reserved words — Clean, check, verify, signals ──────────
echo ""
echo "── 10. Apple SDK reserved words in enums ──"
if [ -n "$CPP_FILES" ]; then
    for f in $CPP_FILES; do
        if git show ":$f" | grep -nE '\b(Clean|Check|Verify)\b' \
            | grep -v '//\|#define\|"' > /tmp/precommit-apple-words.log 2>/dev/null; then
            warn "$f: possible Apple SDK reserved words (Clean/Check/Verify) — may break iOS build"
            cat /tmp/precommit-apple-words.log | while read line; do
                echo "       $line"
            done
        else
            pass "$f"
        fi
    done
else
    pass "no staged C/C++ files"
fi

# ── 11. std::thread join() without joinable() guard ───────────────────────
echo ""
echo "── 11. std::thread join() safety check ──"
if [ -n "$CPP_FILES" ]; then
    for f in $CPP_FILES; do
        if git show ":$f" | grep -n '\.join()' | grep -v 'joinable' > /tmp/precommit-join.log 2>/dev/null; then
            warn "$f: .join() found — verify joinable() guard is present (destructor safety)"
            cat /tmp/precommit-join.log | while read line; do
                echo "       $line"
            done
        else
            pass "$f"
        fi
    done
else
    pass "no staged C/C++ files"
fi


	# ── 12. QML: non-existent properties (iOS static Qt crash) ─────────────────
	echo ""
	echo "── 12. QML non-existent properties (iOS startup crash prevention) ──"
	QML_FILES=$(echo "$STAGED" | grep -E '\.qml$' || true)
	if [ -n "$QML_FILES" ]; then
	    for f in $QML_FILES; do
	        # Rectangle.shadow — does not exist on Qt Quick Rectangle
	        if git show ":$f" | grep -nE 'shadow\.' > /tmp/precommit-qml-shadow.log 2>/dev/null; then
	            fail "$f: Rectangle.shadow is not a valid Qt Quick property (see review/ios-startup-crash-5why-analysis.md#a2)"
	            cat /tmp/precommit-qml-shadow.log | while read line; do
	                echo "       $line"
	            done
	        else
	            pass "$f"
	        fi
	        # border.visible — does not exist
	        if git show ":$f" | grep -nE 'border\.visible' > /tmp/precommit-qml-border.log 2>/dev/null; then
	            fail "$f: border.visible is not a valid Qt Quick Border property (see review/ios-startup-crash-5why-analysis.md#a3)"
	            cat /tmp/precommit-qml-border.log | while read line; do
	                echo "       $line"
	            done
	        else
	            pass "$f"
	        fi
	        # ScaleTransform — deprecated, use Scale
	        if git show ":$f" | grep -nE 'ScaleTransform' > /tmp/precommit-qml-scale.log 2>/dev/null; then
	            fail "$f: ScaleTransform is deprecated — use Scale (QtQuick) (see review/ios-startup-crash-5why-analysis.md#a4)"
	            cat /tmp/precommit-qml-scale.log | while read line; do
	                echo "       $line"
	            done
	        else
	            pass "$f"
	        fi
	        # compact:true — not a standard property
	        if git show ":$f" | grep -nE 'compact:\s*true' > /tmp/precommit-qml-compact.log 2>/dev/null; then
	            fail "$f: compact:true is not a standard Qt Quick property (see review/ios-startup-crash-5why-analysis.md#a5)"
	            cat /tmp/precommit-qml-compact.log | while read line; do
	                echo "       $line"
	            done
	        else
	            pass "$f"
	        fi
	        # font.family with CSS fallback list (comma-separated)
	        if git show ":$f" | grep -nE "font\.family:.*\",\"" > /tmp/precommit-qml-font.log 2>/dev/null; then
	            fail "$f: font.family with comma-separated list — Qt QML takes single family name (see review/ios-startup-crash-5why-analysis.md#a6)"
	            cat /tmp/precommit-qml-font.log | while read line; do
	                echo "       $line"
	            done
	        else
	            pass "$f"
	        fi
	    done
	else
	    pass "no staged QML files"
	fi

	# ── 13. QML: readonly property inside object literal ───────────────────────
	echo ""
	echo "── 13. QML readonly property placement ──"
	if [ -n "$QML_FILES" ]; then
	    for f in $QML_FILES; do
	        # Root-level QML properties are indented 1 tab (inside QtObject/Item).
	        # Properties inside function bodies / object literals are at 2+ tabs.
	        # Filter out 1-tab root-level, flag 2+ tab (potentially nested).
	        if git show ":$f" | grep -n 'readonly property' | grep '^\t\t' > /tmp/precommit-qml-ro.log 2>/dev/null; then
	            fail "$f: readonly property may be inside function/object literal — must be at QML root level (see review/ios-startup-crash-5why-analysis.md#b2)"
	            cat /tmp/precommit-qml-ro.log | while read line; do
	                echo "       $line"
	            done
	        else
	            pass "$f"
	        fi
	    done
	else
	    pass "no staged QML files"
	fi

	# ── 14. QML: document structure validation (5WHY — catch raw data masquerading as QML) ──
	# 5WHY: Translations.qml was replaced with bare t() call data, losing the
	# pragma Singleton + import QtQuick + Item {} envelope. The QML parser hit
	# 't(' at position 1:2 and expected '{', triggering the universal crash chain.
	# This check verifies every staged .qml file starts with a valid QML construct
	# (pragma, import, or // comment) — raw data that hits this check would have
	# been an instant iOS startup crash.  See CRASH-2026-08-05.
	echo ""
	echo "── 14. QML document structure (pragma/import envelope) ──"
	if [ -n "$QML_FILES" ]; then
	    for f in $QML_FILES; do
	        # Skip empty files
	        if [ ! -s "$f" ]; then
	            pass "$f (empty)"
	            continue
	        fi
	        # A valid QML document starts with //, /*, pragma, import, or a known root type.
	        # Common root types: Item, Rectangle, ApplicationWindow, Window, QtObject,
	        # AbstractButton, Button, Pane, Frame, Control, Label, Text, etc.
	        FIRSTLINE=$(git show ":$f" | head -1 | sed 's/^[[:space:]]*//')
	        if echo "$FIRSTLINE" | grep -qE '^(//|/\*|pragma |import |Item\b|Rectangle\b|ApplicationWindow\b|Window\b|QtObject\b|AbstractButton\b|Button\b|Pane\b|Frame\b|Control\b|Label\b|Text\b|Column\b|Row\b|Grid\b|Flow\b|ListView\b|GridView\b|Repeater\b|Loader\b|Flickable\b|ScrollView\b|StackView\b|SwipeView\b|TabBar\b|Drawer\b|Dialog\b|Popup\b|Menu\b|ToolBar\b|Header\b|Footer\b|Page\b|SwipeDelegate\b)'; then
	            pass "$f"
	        else
	            fail "$f: first non-blank line '$FIRSTLINE' is not a valid QML construct — missing pragma/import/root-type. This would cause an iOS startup crash. See review/ios-startup-crash-5why-analysis.md"
	        fi
	    done
	else
	    pass "no staged QML files"
	fi

	# ── 15. QML: QtObject child elements (no default property) ───────────────
	echo ""
	echo "── 15. QML QtObject child elements (no default property) ──"
	if [ -n "$QML_FILES" ]; then
	    for f in $QML_FILES; do
	        # Check for Timer/Item/Rectangle/Connections/Binding as direct child of QtObject
	        # Heuristic: file contains QtObject { AND indented child-object opening braces
	        if git show ":$f" | grep -q 'QtObject\s*{'; then
	            if git show ":$f" | grep -nE '^\s+Timer\s*\{|^\s+Item\s*\{|^\s+Rectangle\s*\{|^\s+Connections\s*\{|^\s+Binding\s*\{' > /tmp/precommit-qtobject-child.log 2>/dev/null; then
	                warn "$f: child elements in QtObject file — QtObject has NO default property. Use Qt.callLater() instead of Timer. See review/ios-startup-crash-5why-analysis.md#i1"
	                cat /tmp/precommit-qtobject-child.log | while read line; do
	                    echo "       $line"
	                done
	            else
	                pass "$f"
	            fi
	        else
	            pass "$f"
	        fi
	    done
	else
	    pass "no staged QML files"
	fi

	# ── 16. C++: static const non-trivial object in header ────────────────────
	echo ""
	echo "── 16. C++ static const in header (SIOF check) ──"
	HEADER_FILES=$(echo "$STAGED" | grep -E '\.h$|\.hpp$' || true)
	if [ -n "$HEADER_FILES" ]; then
	    for f in $HEADER_FILES; do
	        if git show ":$f" | grep -nE 'static const (QMap|QHash|QVector|QList|QStringList|std::map|std::vector|std::unordered_map)' > /tmp/precommit-siof.log 2>/dev/null; then
	            fail "$f: static const non-trivial object in header — SIOF risk, use Meyers Singleton (see review/ios-startup-crash-5why-analysis.md#d2)"
	            cat /tmp/precommit-siof.log | while read line; do
	                echo "       $line"
	            done
	        else
	            pass "$f"
	        fi
	    done
	else
	    pass "no staged header files"
	fi

	# ── 17. SVG icons: fill="none" fill-opacity="0" format check ─────────────
	echo ""
	echo "── 17. SVG icon format (fill=none + fill-opacity=0) ──"
	# Masters live in resources/icons/src/ (build input, not shipped).
	# Generated variants (resources/icons/gen/) are derived from masters and
	# inherit their format — only masters need checking.
	SVG_FILES=$(echo "$STAGED" | grep -E 'icons/src/.*\.svg$' || true)
	if [ -n "$SVG_FILES" ]; then
	    for f in $SVG_FILES; do
	        content=$(git show ":$f" 2>/dev/null)
	        if echo "$content" | head -1 | grep -q '<svg'; then
	            has_none=$(echo "$content" | head -1 | grep -c 'fill="none"' || true)
	            has_opacity=$(echo "$content" | head -1 | grep -c 'fill-opacity="0"' || true)
	            if [ "$has_none" -eq 0 ] || [ "$has_opacity" -eq 0 ]; then
	                fail "$f: SVG root must have BOTH fill=\"none\" AND fill-opacity=\"0\" (iOS/desktop cross-platform requirement)"
	            else
	                pass "$f"
	            fi
	        else
	            pass "$f"
	        fi
	    done
	else
	    pass "no staged icon SVGs"
	fi

	# ── 18. SVG icons: generated variants must be registered in QRC ────────
	echo ""
	echo "── 18. SVG icon QRC registration (resources_icons.qrc) ──"
	if [ -n "$SVG_FILES" ]; then
	    for f in $SVG_FILES; do
	        basename=$(basename "$f")
	        if ! grep -q "$basename" "$ROOT/resources/resources_icons.qrc"; then
	            fail "$f: no generated variants in resources/resources_icons.qrc — run: python scripts/generate-colored-icons.py"
	        else
	            pass "$f"
	        fi
	    done
	else
	    pass "no staged icon SVGs"
	fi

	# ── 19. Pre-generated colored icons: staleness check ────────────────────
	# 5WHY: AppIcon selects from pre-generated qrc:/icons/gen/ variants
	# (scripts/generate-colored-icons.py).  If Palette.js or a master icon
	# changes without regeneration, nearest-color matching silently snaps
	# to stale colors.
	echo ""
	echo "── 19. Pre-generated icon staleness (icons/gen vs Palette.js) ──"
	GEN_INPUTS=$(echo "$STAGED" | grep -E '(theme/Palette\.js|resources/icons/src/[^/]+\.svg)$' || true)
	if [ -n "$GEN_INPUTS" ]; then
	    GEN_OUTPUTS=$(echo "$STAGED" | grep -E 'resources/(icons/gen/|resources_icons\.qrc)' || true)
	    if [ -z "$GEN_OUTPUTS" ]; then
	        fail "Palette.js or master icons changed but icons/gen not regenerated — run: python scripts/generate-colored-icons.py"
	    else
	        pass "icons/gen regenerated alongside inputs"
	    fi
	else
	    pass "generator inputs unchanged"
	fi

	# ── 20. Secrets & signing material (leak prevention) ────────────────────
	# 5WHY: mac_dist.p12 and its password were once committed (history has
	# been purged with filter-repo).  Block any staged signing material and
	# obvious secrets before they ever reach the object database.
	echo ""
	echo "── 20. Secrets & signing material (leak prevention) ──"
	SECRET_FILES=$(echo "$STAGED" | grep -iE '\.(p12|pfx|key|pem|p8|jks|keystore|mobileprovision|provisionprofile|cer|csr)$|(^|/)\.env(\.|$)' || true)
	if [ -n "$SECRET_FILES" ]; then
	    fail "signing material or secret file staged — remove from index:"
	    echo "$SECRET_FILES" | while read -r line; do echo "       $line"; done
	else
	    pass "no signing material staged"
	fi
	for f in $STAGED; do
	    case "$f" in
	        *.png|*.jpg|*.jpeg|*.gif|*.ico|*.icns|*.ttf|*.otf|*.pdf) continue ;;
	    esac
	    if git show ":$f" 2>/dev/null | grep -nE 'BEGIN (RSA |EC |OPENSSH |)PRIVATE KEY|storepass +[^ $]|keypass +[^ $]' | grep -vE 'storepass android|keypass android' > /tmp/precommit-secrets.log 2>/dev/null; then
	        fail "$f: embedded private key or hardcoded keystore password"
	        cat /tmp/precommit-secrets.log | while read -r line; do echo "       $line"; done
	    fi
	done

	# ── 21. QML syntax validation (qmllint + structural check) ─────────────────
	echo ""
	echo "── 21. QML syntax (qmllint + document structure) ──"
	QML_FILES=$(echo "$STAGED" | grep -E '\.qml$' || true)
	if [ -n "$QML_FILES" ]; then
	    QMLLINT=""
	    for candidate in /usr/lib/qt6/bin/qmllint /usr/libexec/qt6/bin/qmllint \
	                    /usr/bin/qmllint /opt/homebrew/bin/qmllint \
	                    "$(which qmllint 2>/dev/null || true)"; do
	        if [ -x "$candidate" ]; then QMLLINT="$candidate"; break; fi
	    done
	    if [ -n "$QMLLINT" ]; then
	        for f in $QML_FILES; do
	            if "$QMLLINT" "$ROOT/$f" > /tmp/precommit-qmllint.log 2>&1; then
	                pass "$f (qmllint OK)"
	            else
	                fail "$f: qmllint found issues:"
	                cat /tmp/precommit-qmllint.log | while read -r line; do echo "       $line"; done
	            fi
	        done
	    else
	        for f in $QML_FILES; do
	            FIRST_LINE=$(git show ":$f" | head -1)
	            if echo "$FIRST_LINE" | grep -qE '^(//|/\*|pragma Singleton|import |Item \{|ApplicationWindow \{|Window \{|Rectangle \{|QtObject \{|Dialog \{|Popup \{|Pane \{|SwipeView \{|StackView \{|ColumnLayout \{|RowLayout \{|GridLayout \{|Frame \{|Control \{|ScrollView \{|SplitView \{|Page \{)'; then
	                pass "$f (structure OK)"
	            else
	                fail "$f: first line does not start with a valid QML construct. Got: '$FIRST_LINE'"
	            fi
	        done
	    fi
	else
	    echo "  (no staged QML files)"
	fi

	# ── Summary ────────────────────────────────────────────────────────────────
	echo ""
	echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	if [ $EXIT -eq 0 ]; then
	    echo -e "${GREEN}  All pre-commit checks passed ✓${NC}"
	    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	    exit 0
	else
	    echo -e "${RED}  Pre-commit checks FAILED — fix above issues before committing${NC}"
	    echo "  See: review/ios-startup-crash-5why-analysis.md for iOS crash analysis"
	    echo "  See: review/ios-ci-known-issues.md for CI/build known issues"
	    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	    exit 1
	fi
