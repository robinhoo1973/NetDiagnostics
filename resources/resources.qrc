<RCC>
    <qresource prefix="/">
        <!-- Root views -->
        <file alias="qml/main.qml">../src/Common/View/main.qml</file>
        <file alias="qml/AppContent.qml">../src/Common/View/AppContent.qml</file>

        <!-- Theme -->
        <file alias="qml/theme/ThemeEngine.qml">../src/Common/View/theme/ThemeEngine.qml</file>
        <file alias="qml/theme/TranslationsProxy.qml">../src/Common/View/theme/TranslationsProxy.qml</file>
        <file alias="translations.json">translations.json</file>
        <file alias="qml/theme/Palette.js">../src/Common/View/theme/Palette.js</file>
        <file alias="qml/theme/qmldir">../src/Common/View/theme/qmldir</file>

        <!-- Screens (page-specific) -->
        <file alias="qml/screens/qmldir">screens-qmldir</file>
        <file alias="qml/screens/DashboardScreen.qml">../src/Dashboard/View/DashboardScreen.qml</file>
        <file alias="qml/screens/DiagnosticScreen.qml">../src/Diagnostics/View/DiagnosticScreen.qml</file>
        <file alias="qml/screens/DetailPage.qml">../src/Diagnostics/View/DetailPage.qml</file>
        <file alias="qml/detail/MetricCard.qml">../src/Common/View/detail/MetricCard.qml</file>
        <file alias="qml/detail/TerminalBlock.qml">../src/Common/View/detail/TerminalBlock.qml</file>
        <file alias="qml/detail/KeyMetric.js">../src/Common/View/detail/KeyMetric.js</file>
        <file alias="qml/detail/viz/qmldir">../src/Common/View/detail/viz/qmldir</file>
        <file alias="qml/detail/viz/Gauge.qml">../src/Common/View/detail/viz/Gauge.qml</file>
        <file alias="qml/detail/viz/BarChart.qml">../src/Common/View/detail/viz/BarChart.qml</file>
        <file alias="qml/detail/viz/ResultChart.qml">../src/Common/View/detail/viz/ResultChart.qml</file>
        <file alias="qml/screens/ConfigScreen.qml">../src/Configuration/View/ConfigScreen.qml</file>
        <file alias="qml/screens/SettingsScreen.qml">../src/Settings/View/SettingsScreen.qml</file>
        <!-- HtmlPreviewWebView → resources_webview.qrc (conditional) -->
        <file alias="qml/dialogs/qmldir">../src/Common/View/dialogs/qmldir</file>
        <file alias="qml/dialogs/PremiumDialog.qml">../src/Common/View/dialogs/PremiumDialog.qml</file>

        <!-- Shared widgets -->
        <file alias="qml/widgets/qmldir">../src/Common/View/widgets/qmldir</file>
        <file alias="qml/widgets/SchemeSelector.qml">../src/Common/View/widgets/SchemeSelector.qml</file>
        <file alias="qml/widgets/PremiumCard.qml">../src/Common/View/widgets/PremiumCard.qml</file>
        <file alias="qml/widgets/CollapsibleSectionHeader.qml">../src/Common/View/widgets/CollapsibleSectionHeader.qml</file>
        <file alias="qml/widgets/DiagGroupPanel.qml">../src/Common/View/widgets/DiagGroupPanel.qml</file>
        <file alias="qml/widgets/DiagBlock.qml">../src/Common/View/widgets/DiagBlock.qml</file>
        <file alias="qml/widgets/DiagTileGrid.qml">../src/Common/View/widgets/DiagTileGrid.qml</file>
        <file alias="qml/widgets/DiagAnimator.qml">../src/Common/View/widgets/DiagAnimator.qml</file>
        <file alias="qml/widgets/animations/JiggleAnimation.qml">../src/Common/View/widgets/animations/JiggleAnimation.qml</file>
        <file alias="qml/widgets/animations/BounceAnimation.qml">../src/Common/View/widgets/animations/BounceAnimation.qml</file>
        <file alias="qml/widgets/animations/PathAnimation.qml">../src/Common/View/widgets/animations/PathAnimation.qml</file>
        <file alias="qml/widgets/animations/PulseAnimation.qml">../src/Common/View/widgets/animations/PulseAnimation.qml</file>
        <file alias="qml/widgets/animations/TypeAnimation.qml">../src/Common/View/widgets/animations/TypeAnimation.qml</file>
        <file alias="qml/widgets/animations/LockAnimation.qml">../src/Common/View/widgets/animations/LockAnimation.qml</file>
        <file alias="qml/theme/AnimationTokens.js">../src/Common/View/theme/AnimationTokens.js</file>
        <file alias="qml/widgets/AppBar.qml">../src/Common/View/widgets/AppBar.qml</file>
        <file alias="qml/widgets/AppIcon.qml">../src/Common/View/widgets/AppIcon.qml</file>
        <file alias="qml/widgets/AppLabel.qml">../src/Common/View/widgets/AppLabel.qml</file>
        <file alias="qml/widgets/IconColors.js">../src/Common/View/widgets/IconColors.js</file>
        <file alias="qml/widgets/ShareButtons.qml">../src/Common/View/widgets/ShareButtons.qml</file>
        <file alias="qml/widgets/StatusBadge.qml">../src/Common/View/widgets/StatusBadge.qml</file>
        <file alias="qml/widgets/SummaryCards.qml">../src/Common/View/widgets/SummaryCards.qml</file>
        <file alias="qml/widgets/DiagnosticToolbar.qml">../src/Common/View/widgets/DiagnosticToolbar.qml</file>
        <file alias="qml/widgets/ZoomBar.qml">../src/Common/View/widgets/ZoomBar.qml</file>
        <!-- HtmlPreviewWebView → resources_webview.qrc (conditional) -->
        <!-- NativePdfPageView   → resources_nativepdf.qrc (conditional) -->

        <!-- Icons (stay in resources/) -->
        <file>icons/netanalysis.ico</file>

        <!-- Fonts (stay in resources/) -->
        <file>fonts/JetBrainsMono-Regular.ttf</file>
        <file>fonts/JetBrainsMono-Bold.ttf</file>
        <file>fonts/DejaVuSansMono.ttf</file>

        <!-- Config (stay in resources/) -->
        <file>qtquickcontrols2.conf</file>

    </qresource>
</RCC>
