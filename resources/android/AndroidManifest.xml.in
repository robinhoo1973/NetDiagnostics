<?xml version="1.0" encoding="utf-8"?>
<!--
    Versioned AndroidManifest TEMPLATE.

    5WHY: This file used to hardcode versionCode="1" / versionName="0.0.1",
    so every APK reported 0.0.1 no matter what release tag was built
    (e.g. v0.0.3).  versionName is what users see; versionCode is what
    Android uses to decide whether an install is an upgrade — both must
    track PROJECT_VERSION.

    CMake (cmake/netdiag-target.cmake) substitutes the two placeholders
    below via configure_file() and writes the real manifest into
    ${CMAKE_BINARY_DIR}/android/AndroidManifest.xml, which is the
    QT_ANDROID_PACKAGE_SOURCE_DIR androiddeployqt actually consumes.
    Do NOT edit a checked-out AndroidManifest.xml — it is generated.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.netdiagnostic.app"
    android:versionCode="@ANDROID_VERSION_CODE@"
    android:versionName="@ANDROID_VERSION_NAME@">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33"/>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>

    <!-- 5WHY (diagnostics completeness): the following permissions unlock the
         detailed Android diagnostics:
         - ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION: WifiInfo.getSSID()/
           getBSSID() return "<unknown ssid>/02:00:00:00:00:00" without a
           location grant on Android 8.1+.  Requested at runtime by
           NetDiagApplication.requestDiagnosticPermissions().
         - READ_PHONE_STATE (API 26-30) / READ_BASIC_PHONE_STATE (API 31+,
           normal permission, auto-granted): TelephonyManager
           getNetworkOperatorName()/getNetworkOperator()/getDataNetworkType()
           return empty/UNKNOWN without them on Android 10+.
         - QUERY_ALL_PACKAGES: G3NetskopeStatus detects security-proxy agents
           (Netskope/Zscaler) by installed-package name. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>

    <!-- 5WHY (Android cleartext): targetSdk 28+ blocks plain http:// by
         default ("CLEARTEXT communication not permitted").  G5 HTTP
         diagnostics (G5CurlVerbose/HttpHeaders/HttpTiming/...) probe
         http:// targets through HttpURLConnection, which honours the
         cleartext policy — without this flag every plain-HTTP diagnostic
         fails on Android 9+.  Raw-socket tests and Qt QNAM are unaffected,
         but HttpURLConnection needs the explicit opt-in. -->

    <!-- 5WHY (Android 9/10 Download mirror): only the C++ raw-path fallback
         (AndroidDownloadLog.h) writes /sdcard/Download/ on API 26-28, and it
         needs this runtime grant.  maxSdkVersion=28: on API 29+ the
         MediaStore path needs no permission and scoped storage ignores this
         legacy permission anyway.  NetDiagApplication requests it once at
         runtime on API <= 28; denial is non-fatal. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>

    <application
        android:name="com.netdiagnostic.app.NetDiagApplication"
        android:label="NetDiagnostics"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@drawable/ic_launcher">
        <!-- 5WHY (Android IME): adjustResize makes the system resize the window
             when the soft keyboard appears (the target field stays visible above
             it) and ensures the IME opens reliably when a text field gains focus. -->
        <activity
            android:name="@ND_QT_BINDINGS_PACKAGE@.QtActivity"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:label="NetDiagnostics"
            android:launchMode="singleTop"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="android.app.lib_name" android:value="net_diagnostics"/>
        </activity>

        <!-- FileProvider: shares generated report files (PDF/HTML) via ACTION_SEND.
             Requires the androidx.core:core gradle dependency (bundled by Qt's
             AndroidX template). Authority must equal package + ".fileprovider". -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.netdiagnostic.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
    </application>
</manifest>
