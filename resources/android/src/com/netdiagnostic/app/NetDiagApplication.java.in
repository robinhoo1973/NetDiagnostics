// =============================================================================
// NetDiagApplication.java (GENERATED from NetDiagApplication.java.in by CMake)
// — earliest Java startup hook for NetDiagnostics
// =============================================================================
// 5WHY (Android no-log bug / startup crash): crashes that happen before the
// native library runs produced no log at all.  Android instantiates the
// <application> class before ANY Activity, so overriding onCreate() here is
// the earliest hook in the app lifecycle.  super.onCreate() loads the Qt
// native libraries — the exact point where "闪退" (instant crash) failures
// occur (missing .so, JNI_OnLoad failure, Qt plugin init).  We write a marker
// BEFORE calling super so even a load crash leaves a user-visible log trail.
//
// The manifest must declare this class:
//   <application android:name="com.netdiagnostic.app.NetDiagApplication" ...>
//
// 5WHY (Qt version upgrade): the Qt Android Java binding package is NOT
// stable across Qt versions — Qt 6.5.x ships org.qtproject.qt.android.
// bindings (Qt5-era name), while a newer Qt may move to org.qtproject.qt6.
// android.bindings.  cmake/netdiag-target.cmake DETECTS the package from the
// actual Qt install and substitutes it for @ND_QT_BINDINGS_PACKAGE@ here and
// in AndroidManifest.xml.in, so an upgrade either adapts automatically or
// fails fast at configure time (instead of an APK that crashes at launch with
// ClassNotFoundException).  Do NOT hand-edit this file — edit the .in source.
package com.netdiagnostic.app;

import @ND_QT_BINDINGS_PACKAGE@.QtApplication;

import android.Manifest;
import android.app.Activity;
import android.app.Application;
import android.content.pm.PackageManager;
import android.os.Build;

public class NetDiagApplication extends QtApplication {

    // 5WHY (Android 9/10 Download mirror): the C++ raw-path fallback writes
    // /sdcard/Download/NetDiagnostics/ on API 26-28, which requires the
    // WRITE_EXTERNAL_STORAGE runtime grant.  Request it once, non-blocking:
    // a denial only degrades the public Download mirror on those devices
    // (app-scoped file + logcat still work).  API 29+ uses MediaStore and
    // needs no permission.
    private static final int REQ_WRITE_STORAGE = 0x2B1;
    private boolean mStorageGrantRequested = false;

    @Override
    public void onCreate() {
        // MUST log BEFORE super.onCreate(): super loads the Qt native
        // libraries, which is where early startup crashes happen.
        // init() stores the app Context so native code can mirror log lines
        // to the public Download folder via EarlyLog.appendToDownloads().
        EarlyLog.init(this);
        EarlyLog.write(this, "Java Application.onCreate — BEFORE Qt native libs load");
        try {
            super.onCreate();
        } catch (Throwable t) {
            // Record even a failed Qt init, then rethrow so the OS reports it.
            EarlyLog.write(this, "Java Application.onCreate — EXCEPTION loading Qt libs: "
                    + t.getClass().getName() + ": " + t.getMessage());
            throw t;
        }
        EarlyLog.write(this, "Java Application.onCreate — Qt native libs loaded OK");
        requestStorageForDownloadMirror();
    }

    private void requestStorageForDownloadMirror() {
        if (Build.VERSION.SDK_INT > Build.VERSION_CODES.P) // API 28 max
            return;
        if (mStorageGrantRequested)
            return;
        mStorageGrantRequested = true;
        registerActivityLifecycleCallbacks(new Application.ActivityLifecycleCallbacks() {
            @Override
            public void onActivityResumed(Activity activity) {
                if (activity.checkSelfPermission(Manifest.permission.WRITE_EXTERNAL_STORAGE)
                        != PackageManager.PERMISSION_GRANTED) {
                    activity.requestPermissions(
                            new String[]{Manifest.permission.WRITE_EXTERNAL_STORAGE},
                            REQ_WRITE_STORAGE);
                }
            }
            @Override public void onActivityCreated(Activity a, android.os.Bundle b) {}
            @Override public void onActivityStarted(Activity a) {}
            @Override public void onActivityPaused(Activity a) {}
            @Override public void onActivityStopped(Activity a) {}
            @Override public void onActivitySaveInstanceState(Activity a, android.os.Bundle b) {}
            @Override public void onActivityDestroyed(Activity a) {}
        });
    }
}
