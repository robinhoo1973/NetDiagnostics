<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  macOS App Store entitlements.

	  IMPORTANT — macOS vs iOS difference:
	  - iOS: com.apple.application-identifier is auto-derived by
	    codesign from the provisioning profile at signing time.
	  - macOS: codesign does NOT auto-derive it when --entitlements
	    is used; it MUST be explicitly present in this file with the
	    value <TeamID>.<BundleID> or App Store Connect emits warning
	    90886 ("signature missing application identifier").

	  The CI action (upload-testflight-macos) extracts the Team ID
	  from the provisioning profile and injects:
	    com.apple.application-identifier = <TeamID>.com.netdiagnostic.app
	  into the generated entitlements before codesign runs.

	  Do NOT hardcode a Team ID here — it varies per Apple Developer
	  account and is extracted at signing time from the profile.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
